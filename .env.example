# Copy to .env and fill in.
# The Anthropic SDK reads ANTHROPIC_API_KEY automatically.
ANTHROPIC_API_KEY=sk-ant-...

# Model id used for the lead agent, subagents and teammates.
MODEL_ID=claude-sonnet-4-5-20250929

# Optional: switched to after repeated 529 (overloaded) errors.
FALLBACK_MODEL_ID=claude-haiku-4-5-20251001

# Optional: point at a proxy / compatible endpoint instead of the Anthropic API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
